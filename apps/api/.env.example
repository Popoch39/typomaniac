DATABASE_URL=postgres://typomaniac:typomaniac@localhost:5434/typomaniac
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
# true only behind a reverse proxy (client IP read from X-Forwarded-For)
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Signs the session cookies, 32 characters minimum: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The API's public URL: OAuth callbacks are <BETTER_AUTH_URL>/api/auth/callback/<provider>
BETTER_AUTH_URL=http://localhost:3000
# Optional providers: set both halves of a pair to enable it, or neither.
# A half-set pair stops the server at startup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The Photos' S3 storage, all four or none (none: no Photo is sent). These are the dev SeaweedFS of
# compose.yaml (docker compose up -d seaweedfs), whose bucket is made at the first Photo.
S3_ENDPOINT=http://localhost:8334
S3_BUCKET=photos
S3_ACCESS_KEY_ID=typomaniac
S3_SECRET_ACCESS_KEY=typomaniac-dev-secret
