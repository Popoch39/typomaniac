{
  "name": "api",
  "version": "1.0.50",
  "module": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile dist/server src/index.ts",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/database/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.30",
    "handle": "workspace:*",
    "pino": "^10.3.1",
    "ranked": "workspace:*",
    "typing-engine": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3"
  }
}
