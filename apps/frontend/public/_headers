# Cache rules for Cloudflare Pages, copied to the root of dist/. deploy/nginx.conf applies the same
# ones. index.html keeps the host's default, revalidated at each visit: it names the chunks of the
# latest deploy. With no 404.html, Pages serves index.html for every other path, as an SPA.

# Named after their content by Vite: new content, new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The same names from one deploy to the next.
/favicons/*
  Cache-Control: public, max-age=86400

/sounds/*
  Cache-Control: public, max-age=86400
